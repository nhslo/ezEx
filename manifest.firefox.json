{
  "manifest_version": 2,
  "name": "ezEx",
  "version": "2.5.0",
  "description": "Teams, Microsoft Forms и Google Forms: Gemini, Claude, GPT и другие модели.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "https://forms.office.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://assignments.edu.cloud.microsoft/*",
    "https://forms.cloud.microsoft/*",
    "https://forms.microsoft.com/*",
    "https://res.cdn.office.net/*",
    "https://hive.forms.usercontent.microsoft/*",
    "https://generativelanguage.googleapis.com/*",
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "optional_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*",
    "https://api.groq.com/*",
    "https://api.deepseek.com/*",
    "https://api.mistral.ai/*",
    "https://api.together.xyz/*",
    "https://api.fireworks.ai/*",
    "https://api.cerebras.ai/*",
    "https://api.sambanova.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["shared.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://assignments.edu.cloud.microsoft/*",
        "https://forms.cloud.microsoft/*",
        "https://forms.microsoft.com/*",
        "https://forms.office.com/*",
        "https://res.cdn.office.net/*",
        "https://docs.google.com/forms/*"
      ],
      "js": [
        "shared.js",
        "locale.js",
        "theme.js",
        "google-forms.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_title": "ezEx",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      }
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ezEx@example.local",
      "strict_min_version": "109.0"
    }
  }
}
